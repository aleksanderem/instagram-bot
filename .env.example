PORT=3000
APP_BASE_URL=https://your-public-domain.example
DATABASE_PATH=./data/instagram-copilot.json

# Generate a random URL-safe value, used by Meta during webhook verification.
META_VERIFY_TOKEN=replace-me
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# A base64-encoded 32-byte key. Generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: without this key, messages are safely routed to review instead of sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BRAND_CONTEXT_PATH=./brand.md

# Required to read or send items in the moderation queue.
ADMIN_API_KEY=replace-with-a-long-random-value

# Keep false while validating the bot's tone. When true, only high-confidence
# drafts that pass all safety rules will be sent automatically.
AUTO_SEND_CONFIDENT_DRAFTS=false

# Optional, comma-separated IDs of Instagram professional accounts the bot may serve.
ALLOWED_INSTAGRAM_ACCOUNT_IDS=
